pipeline {
    agent any

    environment {
        JAVA_HOME = "C:\\Program Files\\Java\\jdk-17"
        PATH = "${JAVA_HOME}\\bin;C:\\Program Files\\apache-maven-3.9.11\\bin;${env.PATH}"
        SERVER_PORT = "9090"
    }

    stages {

        stage('Checkout Code') {
            steps {
                git url: 'https://github.com/swetha-200160/java-project.git', branch: 'master'
            }
        }

        stage('Check Java & Maven') {
            steps {
                bat '''
                echo JAVA_HOME=%JAVA_HOME%
                java -version
                mvn -v
                '''
            }
        }

        stage('Build JAR') {
            steps {
                dir('java-project-master') {
                    bat 'mvn clean package'
                }
            }
        }

        stage('Run JAR on Port 9090') {
            steps {
                dir('java-project-master') {
                    bat '''
                    echo ===============================
                    echo Starting Java server on 9090
                    echo ===============================
                    start "" java -jar target\\hello-jar-1.0.0.jar
                    '''
                }
            }
        }

        stage('Verify Deployment') {
            steps {
                powershell '''
                Write-Host "Waiting for app startup..."
                Start-Sleep -Seconds 8

                Write-Host "Checking if port 9090 is listening..."
                $result = netstat -ano | findstr 9090

                if ($result) {
                    Write-Host "✅ App is running on port 9090"
                } else {
                    Write-Error "❌ Port 9090 not listening"
                    exit 1
                }
                '''
            }
        }
    }

    post {
        success {
            echo '✅ Deployment successful'
        }
        failure {
            echo '❌ Deployment failed'
        }
    }
}
