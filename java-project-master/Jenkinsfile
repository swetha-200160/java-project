pipeline {
    agent any

    stages {

        stage('Checkout Code') {
            steps {
                git branch: 'master',
                    url: 'https://github.com/swetha-200160/java-project.git',
                    credentialsId: 'github'
            }
        }

        stage('Build + Generate SBOM') {
            steps {
                bat 'mvn clean package'
            }
        }

        stage('Archive SBOM') {
            steps {
                archiveArtifacts artifacts: 'target/bom.*', fingerprint: true
            }
        }
    }
}