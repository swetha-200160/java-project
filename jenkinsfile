pipeline {
    agent any

    environment {
        SERVER_NAME = "Can-Chn"
        DEPLOY_PATH = "F:/Deployments/ONDC"
    }

    stages {

        stage('Checkout Code') {
            steps {
                git branch: 'develop',
                    url: 'git@github.com:swetha-200160/java-project.git',
                    credentialsId: 'github-ssh'
            }
        }

        stage('Build JAR') {
            steps {
                bat 'mvn clean package -DskipTests'
            }
        }

        stage('SonarQube Analysis') {
            steps {
                withCredentials([string(credentialsId: 'sonar-token', variable: 'SONAR_TOKEN')]) {
                    bat """
                    mvnw.cmd sonar:sonar ^
                      -Dsonar.host.url=http://localhost:9000 ^
                      -Dsonar.token=%SONAR_TOKEN%
                    """
                }
            }
        }

        stage('Generate SBOM') {
            steps {
                bat '''
                mvn org.cyclonedx:cyclonedx-maven-plugin:2.8.0:makeAggregateBom ^
                  -DskipTests
                '''
            }
        }

        stage('Archive SBOM') {
            steps {
                archiveArtifacts artifacts: 'target/bom.*', fingerprint: true
            }
        }
     stage('Generate ABOM') {
    steps {
        bat '''
        echo Generating ABOM JSON...

        "C:\\Tools\\syft\\syft.exe" "target\\BuyerApp-Motor-0.0.1-SNAPSHOT.jar" -o cyclonedx-json > "target\\abom.json"

        echo Generating ABOM XML...

        "C:\\Tools\\syft\\syft.exe" "target\\BuyerApp-Motor-0.0.1-SNAPSHOT.jar" -o cyclonedx-xml > "target\\abom.xml"

        echo ABOM files generated successfully
        '''
    }
}
      stage('Deploy & Run JAR on Server') {
    steps {
        withCredentials([
            usernamePassword(
                credentialsId: 'winrm-creds',
                usernameVariable: 'WIN_USER',
                passwordVariable: 'WIN_PASS'
            )
        ]) {

            powershell '''
            Write-Host "Connecting to server $env:SERVER_NAME"
            Write-Host "Deploy path: $env:DEPLOY_PATH"

            $sec  = ConvertTo-SecureString $env:WIN_PASS -AsPlainText -Force
            $cred = New-Object System.Management.Automation.PSCredential($env:WIN_USER, $sec)

            $session = New-PSSession `
                -ComputerName $env:SERVER_NAME `
                -Credential $cred `
                -Authentication Kerberos

            # COPY JAR FROM JENKINS TO SERVER
            Copy-Item `
                -Path "target\\BuyerApp-Motor-0.0.1-SNAPSHOT.jar" `
                -Destination "$env:DEPLOY_PATH\\BuyerApp-Motor-0.0.1-SNAPSHOT.jar" `
                -ToSession $session `
                -Force

            # COPY SBOM FILES TO SERVER
            Copy-Item `
                -Path "target\\bom.json" `
                -Destination "$env:DEPLOY_PATH\\bom.json" `
                -ToSession $session `
                -Force

            Copy-Item `
                -Path "target\\bom.xml" `
                -Destination "$env:DEPLOY_PATH\\bom.xml" `
                -ToSession $session `
                -Force

            # COPY ABOM JSON FILE TO SERVER
Copy-Item `
    -Path "target\\abom.json" `
    -Destination "$env:DEPLOY_PATH\\abom.json" `
    -ToSession $session `
    -Force

# COPY ABOM XML FILE TO SERVER
Copy-Item `
    -Path "target\\abom.xml" `
    -Destination "$env:DEPLOY_PATH\\abom.xml" `
    -ToSession $session `
    -Force

            Invoke-Command -Session $session -ScriptBlock {

                Set-Location "F:/Deployments/ONDC"

                Write-Host "Files in deploy folder:"
                dir

                Write-Host "Starting JAR..."

                Start-Process java `
                  -ArgumentList "-jar BuyerApp-Motor-0.0.1-SNAPSHOT.jar" `
                  -RedirectStandardOutput "ondc.out.log" `
                  -RedirectStandardError  "ondc.err.log" `
                  -NoNewWindow
            }

            Remove-PSSession $session
            '''
        }
    }
}
}
}