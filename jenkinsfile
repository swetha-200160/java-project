pipeline {
    agent any

    environment {
        SERVER_IP   = "192.168.0.60"
        DEPLOY_PATH = "F:\\Deployments\\ONDC"
    }

    stages {

        stage('Checkout Code') {
            steps {
                git branch: 'main', url: 'https://your-git-repo-url.git'
            }
        }

        stage('Build JAR') {
            steps {
                bat 'mvn clean package'
            }
        }

        stage('Deploy JAR to Windows Server') {
            steps {
                withCredentials([usernamePassword(
                    credentialsId: 'winrm-creds',
                    usernameVariable: 'WIN_USER',
                    passwordVariable: 'WIN_PASS'
                )]) {

                    powershell '''
                    $secpass = ConvertTo-SecureString "$env:WIN_PASS" -AsPlainText -Force
                    $cred = New-Object System.Management.Automation.PSCredential("$env:WIN_USER", $secpass)

                    # Ensure deployment folder exists on server
                    Invoke-Command -ComputerName $env:SERVER_IP `
                        -Credential $cred `
                        -ScriptBlock {
                            if (!(Test-Path "F:\\Deployments\\ONDC")) {
                                New-Item -ItemType Directory -Path "F:\\Deployments\\ONDC"
                            }
                        }

                    # Copy JAR to server
                    Copy-Item "target\\*.jar" `
                        -Destination "\\\\192.168.0.60\\F$\\Deployments\\ONDC" `
                        -Force
                    '''
                }
            }
        }
    }
}