pipeline {
    agent any

    tools {
        maven 'Maven'
        jdk 'JDK11'
    }

    environment {
        SONARQUBE_ENV = 'SonarQubeServer'
    }

    stages {

        stage('Checkout Code') {
            steps {
                git branch: 'develop',
                    url: 'git@github.com:swetha-200160/repository.git',
                    credentialsId: 'github-ssh'
            }
        }

        stage('Test + SonarQube') {
            steps {
                withSonarQubeEnv("${SONARQUBE_ENV}") {
                    
                    bat """
                    mvn clean verify sonar:sonar ^
                    -Dsonar.projectKey=ondc-project ^
                    -Dsonar.projectName=ondc-project ^
                    -Dsonar.host.url=http://localhost:9000 ^
                    -Dsonar.login=YOUR_TOKEN
                    """
                }
            }
        }

        stage('Quality Gate') {
            steps {
                timeout(time: 2, unit: 'MINUTES') {
                    waitForQualityGate abortPipeline: true
                }
            }
        }

        stage('Build JAR') {
            steps {
                bat 'mvn clean package -DskipTests'
            }
        }
    }

    post {
        success {
            echo 'SUCCESS ✅'
        }
        failure {
            echo 'FAILED ❌ (Test or Sonar issue)'
        }
    }
}