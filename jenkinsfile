pipeline {
    agent any

    environment {
        BRANCH = "develop"
        REPO_URL = "git@github.com:swetha-200160/java-project.git"
        JAR_NAME = "java-project.jar"
    }

    stages {

        stage('Checkout & Build (LOCAL JENKINS)') {
            steps {
                git branch: "${BRANCH}",
                    url: "${REPO_URL}",
                    credentialsId: "github-ssh"

                bat 'mvnw.cmd clean package -DskipTests'
            }
        }

        stage('Deploy & Run JAR (SERVER 192.168.0.60)') {
            agent { label 'ondc-server' }   // 🚀 RUNS ON SERVER
            environment {
                DEPLOY_DIR  = "F:/Deployments/ONDC"
                JAVA_HOME  = "C:/Program Files/Java/jdk-17"
                SERVER_PORT = "9090"
            }
            steps {
                bat """
                echo ===== Running JAR on SERVER =====

                if not exist "%DEPLOY_DIR%" mkdir "%DEPLOY_DIR%"

                echo Copying JAR to server folder
                copy /Y "%WORKSPACE%\\target\\*.jar" "%DEPLOY_DIR%\\%JAR_NAME%"

                echo Stopping old process (if any)
                for /f "tokens=5" %%a in ('netstat -ano ^| findstr :%SERVER_PORT%') do taskkill /PID %%a /F

                echo Starting application from F:\\Deployments\\ONDC
                cd /d "%DEPLOY_DIR%"

                start "" cmd /c "\"%JAVA_HOME%\\bin\\java.exe\" -jar \"%DEPLOY_DIR%\\%JAR_NAME%\" --server.port=%SERVER_PORT% > app.log 2>&1"
                """
            }
        }
    }

    post {
        success {
            echo "✅ JAR is running from F:/Deployments/ONDC on server 192.168.0.60"
        }
        failure {
            echo "❌ Deployment failed – check console output"
        }
    }
}