pipeline {
    agent any   // local Jenkins

    environment {
    BRANCH = "develop"
    REPO_URL = "git@github.com:swetha-200160/java-project.git"

    JAR_NAME = "BuyerApp-Motor-0.0.1-SNAPSHOT.jar"
    DEPLOY_DIR_SERVER_B = "F:/Deployments/ONDC"
}

    stages {

        stage('Build JAR (LOCAL)') {
            steps {
                git branch: BRANCH,
                    url: REPO_URL,
                    credentialsId: 'github-ssh'

                bat 'mvnw.cmd clean package -DskipTests'
            }
        }

        stage('Deploy to Server B') {
    steps {
        sshagent(credentials: ['serverB-ssh']) {
            bat """
            echo Copying JAR to Server B
            scp target\\${JAR_NAME} deployuser@192.168.0.60:F:\\Deployments\\ONDC\\${JAR_NAME}

            echo Stopping application on Server B (port 9090)
            ssh deployuser@192.168.0.60 ^
            "for /f \\"tokens=5\\" %%a in ('netstat -ano ^| findstr :9090') do taskkill /PID %%a /F"

            echo Starting application on Server B
            ssh deployuser@192.168.0.60 ^
            "cd /d F:\\Deployments\\ONDC && start java -jar ${JAR_NAME} --server.port=9090 > app.log 2>&1"
            """
        }
    }
}