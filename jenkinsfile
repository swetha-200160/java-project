pipeline {
    agent any

    environment {
        SERVER_NAME = "Can-Chn"
        DEPLOY_PATH = "F:/Deployments/ONDC"
    }

    stages {

        stage('Checkout Code') {
            steps {
                git branch: 'develop',
                    url: 'git@github.com:swetha-200160/java-project.git',
                    credentialsId: 'github-ssh'
            }
        }

        stage('Build JAR') {
            steps {
                bat 'mvn clean package -DskipTests'
            }
        }

        stage('Deploy & Run JAR on Server') {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'winrm-creds',
                        usernameVariable: 'WIN_USER',
                        passwordVariable: 'WIN_PASS'
                    )
                ]) {

                    powershell '''
                    Write-Host "Connecting to server $env:SERVER_NAME"
                    Write-Host "Deploy path: $env:DEPLOY_PATH"

                    $sec  = ConvertTo-SecureString $env:WIN_PASS -AsPlainText -Force
                    $cred = New-Object System.Management.Automation.PSCredential($env:WIN_USER, $sec)

                    $session = New-PSSession `
                        -ComputerName $env:SERVER_NAME `
                        -Credential $cred `
                        -Authentication Kerberos

                    # COPY JAR FROM JENKINS TO SERVER
                    Copy-Item `
                        -Path "target\\BuyerApp-Motor-0.0.1-SNAPSHOT.jar" `
                        -Destination "F:/Deployments/ONDC/BuyerApp-Motor-0.0.1-SNAPSHOT.jar" `
                        -ToSession $session `
                        -Force

                    Invoke-Command -Session $session -ScriptBlock {

                        Set-Location "F:/Deployments/ONDC"

                        Write-Host "Files in deploy folder:"
                        dir

                        Write-Host "Starting JAR..."

                        Start-Process java `
                          -ArgumentList "-jar BuyerApp-Motor-0.0.1-SNAPSHOT.jar" `
                          -RedirectStandardOutput "ondc.out.log" `
                          -RedirectStandardError  "ondc.err.log" `
                          -NoNewWindow
                    }

                    Remove-PSSession $session
                    '''
                }
            }
        }
    }
}