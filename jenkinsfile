pipeline {
    agent any
 
    environment {
        SERVER_NAME = "RS-server"
    }
 
    stages {
 
        stage('Checkout Code') {
            steps {
                git branch: 'develop',
                    url: 'git@github.com:swetha-200160/java-project.git',
                    credentialsId: 'github-ssh'
            }
        }
 
        stage('Build JAR') {
            steps {
                bat 'mvn clean package -DskipTests'
            }
        }
 
        stage('SonarQube Analysis') {
            steps {
                withCredentials([string(credentialsId: 'sonar-token', variable: 'SONAR_TOKEN')]) {
                    bat """
                    mvnw.cmd sonar:sonar ^
                      -Dsonar.host.url=https://test.canvendor.co.in/sonarqube ^
                      -Dsonar.login=%SONAR_TOKEN% ^
                      -Dsonar.projectKey=BuyerApp-Motor ^
                      -Dsonar.projectName=BuyerApp-Motor
                    """
                }
            }
        }
 
        stage('Generate SBOM') {
            steps {
                bat 'mvn org.cyclonedx:cyclonedx-maven-plugin:2.8.0:makeAggregateBom -DskipTests'
            }
        }
 
        stage('Generate ABOM') {
            steps {
                bat '''
                echo ===== GENERATING ABOM =====
 
                syft.exe target\\BuyerApp-Motor-0.0.1-SNAPSHOT.jar -o cyclonedx-json > target\\abom.json
                syft.exe target\\BuyerApp-Motor-0.0.1-SNAPSHOT.jar -o cyclonedx-xml > target\\abom.xml
 
                echo ===== ABOM DONE =====
                '''
            }
        }
 
        stage('Archive SBOM') {
            steps {
                archiveArtifacts artifacts: 'target/bom.*', fingerprint: true
            }
        }
 
        stage('Deploy to Server 46 (WinRM)') {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'winrm-creds',
                        usernameVariable: 'WIN_USER',
                        passwordVariable: 'WIN_PASS'
                    )
                ]) {
                    powershell '''
 
                    # -------- CONNECT --------
                    $SERVER = "192.168.0.46"
 
                    $sec  = ConvertTo-SecureString $env:WIN_PASS -AsPlainText -Force
                    $cred = New-Object System.Management.Automation.PSCredential($env:WIN_USER, $sec)
 
                    Write-Host "Connecting to Server 46..."
                    $session = New-PSSession -ComputerName $SERVER -Credential $cred -Authentication Negotiate
 
                    # -------- PATHS --------
                    $localJar  = "target\\BuyerApp-Motor-0.0.1-SNAPSHOT.jar"
                    $remoteDir = "C:\\Users\\swethasuresh\\test.ondc"
 
                    # -------- CREATE FOLDER --------
                    Invoke-Command -Session $session -ScriptBlock {
                        param($remoteDir)
                        if (!(Test-Path $remoteDir)) {
                            New-Item -ItemType Directory -Path $remoteDir
                        }
                    } -ArgumentList $remoteDir
 
                    # -------- COPY JAR --------
                    Write-Host "Copying JAR..."
                    Copy-Item -Path $localJar -Destination $remoteDir -ToSession $session -Force
 
                    # -------- RUN JAR --------
                    Invoke-Command -Session $session -ScriptBlock {
                        param($remoteDir)
 
                        Set-Location $remoteDir
 
                        Write-Host "Stopping old application..."
                        Get-Process java -ErrorAction SilentlyContinue | Stop-Process -Force
 
                        Start-Sleep -Seconds 3
 
                        Write-Host "Starting new application..."
 
                        Start-Process "java" `
                          -ArgumentList "-jar BuyerApp-Motor-0.0.1-SNAPSHOT.jar" `
                          -WorkingDirectory $remoteDir `
                          -RedirectStandardOutput "$remoteDir\\app.out.log" `
                          -RedirectStandardError "$remoteDir\\app.err.log" `
                          -NoNewWindow
 
                    } -ArgumentList $remoteDir
 
                    # -------- CLOSE SESSION --------
                    Remove-PSSession $session
 
                    Write-Host "Deployment Completed Successfully"
 
                    '''
                }
            }
        }
    }
}    