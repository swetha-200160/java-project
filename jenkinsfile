pipeline {
    agent any

    triggers {
        githubPush()
    }

    environment {
        BRANCH = "develop"
        REPO_URL = "git@github.com:swetha-200160/java-project.git"

        // LOCAL (Jenkins)
        LOCAL_JAR = "target\\*.jar"

        // REMOTE SERVER DETAILS
        REMOTE_USER = "administrator"        // change if needed
        REMOTE_HOST = "192.168.0.60"
        REMOTE_DIR  = "F:/Deployments/ONDC"

        JAR_NAME  = "ONDC"
        JAVA_CMD  = "C:/Program Files/Java/jdk-17/bin/java"
    }

    stages {

        stage('Checkout Code') {
            steps {
                git branch: "${BRANCH}",
                    url: "${REPO_URL}",
                    credentialsId: "github-ssh"
            }
        }

        stage('Build Maven Package') {
            steps {
                bat 'mvnw.cmd clean package -DskipTests'
            }
        }

        stage('SonarQube Analysis') {
            steps {
                withSonarQubeEnv('SonarQube') {
                    bat 'mvnw.cmd sonar:sonar'
                }
            }
        }

        stage('Copy JAR to Remote Server') {
            steps {
                bat """
                echo Copying JAR to remote server...
                scp ${LOCAL_JAR} ${REMOTE_USER}@${REMOTE_HOST}:${REMOTE_DIR}/${JAR_NAME}
                """
            }
        }

        stage('Run JAR on Remote Server') {
            steps {
                bat """
                ssh ${REMOTE_USER}@${REMOTE_HOST} ^
                "taskkill /F /IM java.exe 2>nul ^& ^
                 cd ${REMOTE_DIR} ^& ^
                 start cmd /c \\"${JAVA_CMD} -jar ${JAR_NAME} --server.port=9090 > app.log 2>&1\\""
                """
            }
        }
    }

    post {
        success {
            echo "✅ SUCCESS: JAR deployed & running on remote server (192.168.0.60)"
        }
        failure {
            echo "❌ FAILED: Check Jenkins & server logs"
        }
    }
}