pipeline {
    agent any

    environment {
        SERVER_NAME = "RS-server"
        REMOTE_SERVER = "192.168.0.46"
        REMOTE_DIR = "C:\\Users\\swethasuresh\\test.ondc"
        JAR_NAME = "BuyerApp-Motor-0.0.1-SNAPSHOT.jar"
    }

    stages {

        stage('Checkout Code') {
            steps {
                git branch: 'develop',
                    url: 'git@github.com:swetha-200160/java-project.git',
                    credentialsId: 'github-ssh'
            }
        }

        stage('Build JAR') {
            steps {
                bat 'mvn clean package -DskipTests'
            }
        }

        stage('SonarQube Analysis') {
            steps {
                withCredentials([string(credentialsId: 'sonar-token', variable: 'SONAR_TOKEN')]) {
                    bat """
                    mvnw.cmd sonar:sonar ^
                      -Dsonar.host.url=https://test.canvendor.co.in/sonarqube ^
                      -Dsonar.login=%SONAR_TOKEN% ^
                      -Dsonar.projectKey=BuyerApp-Motor ^
                      -Dsonar.projectName=BuyerApp-Motor
                    """
                }
            }
        }

        stage('Generate SBOM') {
            steps {
                bat 'mvn org.cyclonedx:cyclonedx-maven-plugin:2.8.0:makeAggregateBom -DskipTests'
            }
        }

        stage('Generate ABOM') {
            steps {
                bat '''
                echo ===== GENERATING ABOM =====

                syft.exe target\\BuyerApp-Motor-0.0.1-SNAPSHOT.jar -o cyclonedx-json > target\\abom.json
                syft.exe target\\BuyerApp-Motor-0.0.1-SNAPSHOT.jar -o cyclonedx-xml > target\\abom.xml

                echo ===== ABOM DONE =====
                '''
            }
        }

        stage('Archive SBOM') {
            steps {
                archiveArtifacts artifacts: 'target/bom.*', fingerprint: true
            }
        }

        stage('Deploy to Server 46 (WinRM)') {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'winrm-creds',
                        usernameVariable: 'WIN_USER',
                        passwordVariable: 'WIN_PASS'
                    )
                ]) {
                    powershell '''

                    # -------- CONNECT --------
                    $SERVER = "${env.REMOTE_SERVER}"

                    $sec  = ConvertTo-SecureString $env:WIN_PASS -AsPlainText -Force
                    $cred = New-Object System.Management.Automation.PSCredential($env:WIN_USER, $sec)

                    Write-Host "Connecting to Server 46..."
                    $session = New-PSSession -ComputerName $SERVER -Credential $cred -Authentication Negotiate

                    # -------- PATHS --------
                    $localJar  = "target\\${env.JAR_NAME}"
                    $remoteDir = "${env.REMOTE_DIR}"
                    $jarName   = "${env.JAR_NAME}"

                    # -------- CREATE FOLDER --------
                    Invoke-Command -Session $session -ScriptBlock {
                        param($remoteDir)
                        if (!(Test-Path $remoteDir)) {
                            New-Item -ItemType Directory -Path $remoteDir | Out-Null
                        }
                    } -ArgumentList $remoteDir

                    # -------- SHOW + STOP OLD JAR USING PID --------
                    Invoke-Command -Session $session -ScriptBlock {
                        param($jarName)

                        Write-Host "🔍 Checking running ONDC JAR..."

                        $processes = Get-CimInstance Win32_Process | Where-Object {
                            $_.CommandLine -match [regex]::Escape($jarName)
                        }

                        if ($processes) {
                            foreach ($p in $processes) {

                                Write-Host "================================="
                                Write-Host "FOUND PID: $($p.ProcessId)"
                                Write-Host "COMMAND: $($p.CommandLine)"
                                Write-Host "================================="

                                Stop-Process -Id $p.ProcessId -Force

                                Write-Host "❌ STOPPED PID: $($p.ProcessId)"
                            }

                            Start-Sleep -Seconds 3
                        }
                        else {
                            Write-Host "No ONDC JAR running"
                        }

                    } -ArgumentList $jarName

                    # -------- COPY NEW JAR --------
                    Write-Host "📦 Copying new JAR..."
                    Copy-Item -Path $localJar -Destination $remoteDir -ToSession $session -Force

                    # -------- START NEW JAR --------
                    Invoke-Command -Session $session -ScriptBlock {
                        param($remoteDir, $jarName)

                        Set-Location $remoteDir

                        Write-Host "🚀 Starting new ONDC JAR..."

                        Start-Process "java" `
                          -ArgumentList "-jar $jarName" `
                          -WorkingDirectory $remoteDir `
                          -RedirectStandardOutput "$remoteDir\\app.out.log" `
                          -RedirectStandardError "$remoteDir\\app.err.log" `
                          -NoNewWindow

                        Start-Sleep -Seconds 5

                        # -------- VERIFY START --------
                        $newProcess = Get-CimInstance Win32_Process | Where-Object {
                            $_.CommandLine -match [regex]::Escape($jarName)
                        }

                        if ($newProcess) {
                            Write-Host "✅ New JAR started successfully"
                            $newProcess | Select ProcessId, CommandLine
                        } else {
                            Write-Host "❌ New JAR failed to start"
                        }

                    } -ArgumentList $remoteDir, $jarName

                    # -------- CLOSE SESSION --------
                    Remove-PSSession $session

                    Write-Host "🎉 Deployment Completed Successfully"

                    '''
                }
            }
        }
    }
}